<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="MyTargets"
         InitialTargets="MyTargets">
  <UsingTask AssemblyFile="..\tools\WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerBuildTask"/>
  <UsingTask AssemblyFile="..\tools\WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerCleanTask"/>
  <UsingTask AssemblyFile="..\tools\BundlerMinifier\BundlerMinifier.exe" TaskName="BundlerMinifier.BundlerBuildTask"/>
  <UsingTask AssemblyFile="..\tools\BundlerMinifier\BundlerMinifier.exe" TaskName="BundlerMinifier.BundlerCleanTask"/>

  <Target Name="MyTargets">
    <WebCompiler.CompilerCleanTask FileName="$(MSBuildProjectDirectory)\..\assets\compilerconfig.json" />
    <WebCompiler.CompilerBuildTask FileName="$(MSBuildProjectDirectory)\..\assets\compilerconfig.json" />
	<BundlerMinifier.BundlerCleanTask FileName="$(MSBuildProjectDirectory)\..\assets\bundleconfig.json" />
	<BundlerMinifier.BundlerBuildTask FileName="$(MSBuildProjectDirectory)\..\assets\bundleconfig.json" />
  </Target>
  
</Project>
